{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "lib": [
      "es2022"
    ],
    "resolveJsonModule": true
  },
  "_comment_lib": "不含 dom:核心(gen/data/state/rng)必須能在 renderer 與 Node 兩邊跑,不得碰 DOM;node.ts / cli.ts 才用 Node API。",
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "vitest.config.mts"
  ]
}
